# This file is generated by Terraform
# Do not edit manually

[all:vars]
ansible_connection=ssh
ansible_port=22
ansible_user=matt
ansible_ssh_private_key_file=/root/.ssh/id_ed25519
ansible_become_pass=${ssh_password}

[docker_nodes]
%{ for name, vm in docker_nodes ~}
${name} ansible_host=${split("/", vm.ip_address)[0]}
%{ endfor ~}

[proxy_nodes]
%{ for name, vm in proxy_nodes ~}
${name} ansible_host=${split("/", vm.ip_address)[0]}
%{ endfor ~}

[ungrouped]