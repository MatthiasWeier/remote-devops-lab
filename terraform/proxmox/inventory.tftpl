# This file is generated by Terraform
# Do not edit manually

[all:vars]
ansible_connection=ssh
ansible_port=22
ansible_user=matt
ansible_ssh_private_key_file=~/.ssh/id_ed25519

[control_plane]
%{ for name, vm in control_plane_nodes ~}
${name} ansible_host=${split("/", vm.ip_address)[0]}
%{ endfor ~}

[workers]
%{ for name, vm in worker_nodes ~}
${name} ansible_host=${split("/", vm.ip_address)[0]}
%{ endfor ~}

[k3s_cluster:children]
control_plane
workers

[ungrouped]
