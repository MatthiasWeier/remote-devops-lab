{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "argocd": {
    "managerFilePatterns": ["/^kubernetes/apps/[^/]+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/apps/manifests/.+\\.yaml$/"]
  }
}
